#!/bin/bash
# Shared git pre-commit hook: block staged content that leaks private data or
# secrets, or contains U+FFFD replacement characters (AI edits of Chinese text
# can write them silently). Checks the staged version of each file, not the
# work tree. Secret hits are reported by line number only, so the hook never
# prints the secret itself (D-11).
#
# Install per repository:
#   ln -s ~/agent-system/git-hooks/pre-commit .git/hooks/pre-commit
# Project-specific patterns (real usernames, hostnames): one extended regex per
# line in .git/privacy-patterns; blank lines and lines starting with # are
# skipped. That file lives inside .git, so it is never committed.
# Compatible with macOS bash 3.2.

export LC_ALL=C

ip='(^|[^0-9.])(10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}|192\.168\.[0-9]{1,3}\.[0-9]{1,3})([^0-9]|$)'
home='/(Users|home)/[A-Za-z0-9_][A-Za-z0-9_.-]+'
fffd=$'\xef\xbf\xbd'
# Secrets (D-11): known token formats, and NAME=value assignments whose name
# looks secret and whose value is a complete run of 16+ token characters
# containing a digit. Values starting with <, $ or { are placeholders or
# variables, and values followed by ( or . are code (sqlite3_column_int64(...)).
known='(^|[^A-Za-z0-9_])(sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|xox[abprs]-[A-Za-z0-9-]{10,})|-----BEGIN [A-Z ]*PRIVATE KEY-----'
assign="(TOKEN|SECRET|PASSWORD|PASSWD|API_?KEY|ACCESS_?KEY|PRIVATE_?KEY)[A-Za-z0-9_]*[\"']?[[:space:]]*[:=][[:space:]]*[\"']?[A-Za-z0-9_+/=-]{16,}([\"'[:space:],;]|$)"
# Applied to the matched text only: the digit must be in the value at its end.
digit="[0-9][A-Za-z0-9_+/=-]*[\"'[:space:],;]?$"

extra=
patterns_file="$(git rev-parse --git-dir)/privacy-patterns"
if [ -f "$patterns_file" ]; then
    # An invalid regex would make grep fail silently and turn the check off,
    # so validate every line and block the commit instead (D-14).
    skip_re='^[[:space:]]*(#|$)'
    bad=0 n=0
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        [[ $line =~ $skip_re ]] && continue
        grep -qE -e "$line" </dev/null 2>/dev/null
        [ $? = 2 ] && { echo "pre-commit: invalid regex in $patterns_file line $n" >&2; bad=1; }
    done < "$patterns_file"
    if [ "$bad" = 1 ]; then
        echo "pre-commit: blocked. Fix the patterns file, then commit again." >&2
        exit 1
    fi
    extra=$(grep -vE "$skip_re" "$patterns_file" | paste -sd '|' -)
fi

found=0
report() {  # report <label> <file> <grep output>
    found=1
    printf '%s\n' "$3" | sed "s|^|  [$1] $2:|" >&2
}
report_hidden() {  # report_hidden <label> <file> <grep -n output>
    found=1
    printf '  [%s] %s: line %s (content hidden)\n' "$1" "$2" \
        "$(printf '%s\n' "$3" | cut -d: -f1 | paste -sd, -)" >&2
}

while IFS= read -r -d '' f; do
    content=$(git show ":$f" 2>/dev/null) || continue
    # Skip binary files. grep -q stops at the first match, so on a large file
    # printf hits a closed pipe; silence that harmless error.
    printf '%s' "$content" 2>/dev/null | grep -qI . || continue

    hits=$(printf '%s\n' "$content" | grep -nE "$ip")
    [ -n "$hits" ] && report "private IP" "$f" "$hits"
    hits=$(printf '%s\n' "$content" | grep -nE "$home")
    [ -n "$hits" ] && report "home path" "$f" "$hits"
    hits=$(printf '%s\n' "$content" | grep -nF "$fffd")
    [ -n "$hits" ] && report "U+FFFD" "$f" "$hits"
    hits=$( { printf '%s\n' "$content" | grep -nE "$known"
              printf '%s\n' "$content" | grep -noiE "$assign" | grep -E "$digit"
            } | sort -t: -k1,1n -u)
    [ -n "$hits" ] && report_hidden "secret" "$f" "$hits"
    if [ -n "$extra" ]; then
        hits=$(printf '%s\n' "$content" | grep -nE -e "$extra" 2>&1)
        if [ $? = 2 ]; then
            echo "pre-commit: privacy-patterns check failed on $f: $hits" >&2
            found=1
        elif [ -n "$hits" ]; then
            report "privacy-patterns" "$f" "$hits"
        fi
    fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ "$found" = 1 ]; then
    echo >&2
    echo "pre-commit: blocked. Replace real values with placeholders (<host>, <user>," >&2
    echo "<token>) and keep secrets out of the repository; fix U+FFFD using Unicode" >&2
    echo "code points, then stage again." >&2
    exit 1
fi
exit 0

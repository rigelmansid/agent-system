#!/bin/bash
# Create a new code project from profiles/code/template, or add the missing
# pieces to an existing directory. Never overwrites an existing file. Exits
# non-zero if any file could not be created or an existing one is empty.
#   new-project <dir> [project name]
# The name defaults to the directory's own name, so "new-project ." works.
# Compatible with macOS bash 3.2.

set -u
root=$(cd "$(dirname "$0")/.." && pwd -P)
tpl="$root/profiles/code/template"

if [ $# -lt 1 ]; then
    echo "usage: new-project <dir> [project name]" >&2
    exit 2
fi
check_name() {
    case $1 in
        ''|*[[:cntrl:]]*) echo "new-project: project name is empty or has control characters" >&2
                          exit 2 ;;
    esac
}
dir=$1
# Check an explicit name before creating anything.
[ $# -ge 2 ] && check_name "$2"
# A P0NN_<name> folder is the container, not the project; running there would
# git init around the real repo and put materials one level too high (D-23).
if [ -d "$dir" ]; then
    target=$(cd "$dir" && basename "$PWD")
else
    target=$(basename "$dir")
fi
case $target in
    P[0-9][0-9][0-9]_*)
        echo "new-project: '$target' is a project container (D-10); run it on the" \
             "project directory inside, e.g. $target/<project>" >&2
        exit 2 ;;
esac
today=$(date +%Y-%m-%d)
now=$(date '+%Y-%m-%d %H:%M')
status=0

mkdir -p "$dir/docs" && cd "$dir" || exit 1
# Take the default from the resolved directory, not the argument: basename of
# "." or "../x/" would give "." or a trailing-slash surprise (D-20).
name=${2:-$(basename "$PWD")}
check_name "$name"

# Replace placeholders literally, so the name may contain / & \ (D-13).
fill() {  # fill <template file>
    NAME=$name TODAY=$today NOW=$now awk '
        function rep(s, a, b,    out, i) {
            out = ""
            while ((i = index(s, a)) > 0) {
                out = out substr(s, 1, i - 1) b
                s = substr(s, i + length(a))
            }
            return out s
        }
        {
            s = rep($0, "<项目名>", ENVIRON["NAME"])
            s = rep(s, "更新：YYYY-MM-DD HH:MM", "更新：" ENVIRON["NOW"])
            s = rep(s, "更新：YYYY-MM-DD", "更新：" ENVIRON["TODAY"])
            print s
        }' "$tpl/$1"
}

# Write through a temp file so a failure never leaves an empty file behind.
put() {  # put <template file> <dest>
    if [ -e "$2" ] || [ -L "$2" ]; then
        if [ -f "$2" ] && [ ! -s "$2" ]; then
            echo "WARNING $2 exists but is empty; not overwritten, delete it and rerun" >&2
            status=1
        else
            echo "kept    $2 (already exists)"
        fi
    elif fill "$1" > "$2.tmp.$$" && [ -s "$2.tmp.$$" ] && mv "$2.tmp.$$" "$2"; then
        echo "created $2"
    else
        rm -f "$2.tmp.$$"
        echo "ERROR   could not create $2" >&2
        status=1
    fi
}

put AGENTS.md AGENTS.md
put docs/project-notes.md docs/project-notes.md
put docs/decisions.md docs/decisions.md
put docs/pitfalls.md docs/pitfalls.md
put docs/log.md docs/log.md
put gitignore .gitignore
[ -e private-notes.md ] || { : > private-notes.md; echo "created private-notes.md"; }
[ -e README.md ] || { printf '# %s\n' "$name" > README.md; echo "created README.md"; }
if [ ! -e CLAUDE.md ] && [ ! -L CLAUDE.md ]; then
    ln -s AGENTS.md CLAUDE.md && echo "linked  CLAUDE.md -> AGENTS.md"
fi

# Project materials live next to the project dir, outside git (RULE.md §4).
# They assume one container folder per project, named P0NN_<name> (D-10);
# without one, ../materials would be shared with sibling projects.
container=$(basename "$(cd .. && pwd -P)")
case $container in
    P[0-9][0-9][0-9]_*) ;;
    *) echo "WARNING container folder '$container' is not named P0NN_<name> (D-10);" \
            "../materials may be shared with other projects" >&2 ;;
esac
for sub in refs inbox scratch; do
    if [ ! -d "../materials/$sub" ]; then
        mkdir -p "../materials/$sub" && echo "created ../materials/$sub"
    fi
done
echo "note    materials: $(cd ../materials && pwd -P)"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git init -q && echo "git init"
fi
hooks_dir=$(git rev-parse --git-path hooks)
if [ ! -e "$hooks_dir/pre-commit" ]; then
    mkdir -p "$hooks_dir"
    ln -s "$root/git-hooks/pre-commit" "$hooks_dir/pre-commit" && echo "linked  pre-commit hook"
else
    echo "kept    $hooks_dir/pre-commit (already exists)"
fi

if git check-ignore -q private-notes.md; then
    echo "ok      private-notes.md is ignored"
else
    echo "WARNING private-notes.md is NOT ignored; check .gitignore" >&2
fi
exit $status

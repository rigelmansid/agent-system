#!/bin/bash
# Create a project from a profile's template, or add the missing pieces to an
# existing directory, then run bin/setup for the machine-local parts (D-41).
# Never overwrites an existing file. Exits 2 on usage errors, and 1 if a file
# could not be created, an existing one is empty, or AGENTS.md does not
# declare this profile.
#   new-project <dir> <profile> [project name]
# The name defaults to the directory's own name, so "new-project . code" works.
# Compatible with macOS bash 3.2.

set -u
root=$(cd "$(dirname "$0")/.." && pwd -P)

profiles() {
    for d in "$root"/profiles/*/; do
        [ -f "$d/PROFILE.md" ] && basename "$d"
    done | paste -sd ' ' -
}
if [ $# -lt 2 ]; then
    echo "usage: new-project <dir> <profile> [project name]   profiles: $(profiles)" >&2
    exit 2
fi
check_name() {
    case $1 in
        ''|*[[:cntrl:]]*) echo "new-project: project name is empty or has control characters" >&2
                          exit 2 ;;
    esac
}
dir=$1
profile=$2
tpl="$root/profiles/$profile/template"
if [ ! -f "$root/profiles/$profile/PROFILE.md" ] || [ ! -d "$tpl" ]; then
    echo "new-project: unknown profile '$profile'; profiles: $(profiles)" >&2
    exit 2
fi
# Check an explicit name before creating anything.
[ $# -ge 3 ] && check_name "$3"
# A P0NN_<name> folder is the container, not the project; running there would
# git init around the real repo and put materials one level too high (D-23).
if [ -d "$dir" ]; then
    target=$(cd "$dir" && basename "$PWD")
else
    target=$(basename "$dir")
fi
case $target in
    P[0-9][0-9][0-9]_*)
        echo "new-project: '$target' is a project container (D-10); run it on the" \
             "project directory inside, e.g. $target/<project>" >&2
        exit 2 ;;
esac
today=$(date +%Y-%m-%d)
now=$(date '+%Y-%m-%d %H:%M')
status=0

mkdir -p "$dir" && cd "$dir" || exit 1
# Take the default from the resolved directory, not the argument: basename of
# "." or "../x/" would give "." or a trailing-slash surprise (D-20).
name=${3:-$(basename "$PWD")}
check_name "$name"

# Replace placeholders literally, so the name may contain / & \ (D-13).
fill() {  # fill <template file>
    NAME=$name TODAY=$today NOW=$now awk '
        function rep(s, a, b,    out, i) {
            out = ""
            while ((i = index(s, a)) > 0) {
                out = out substr(s, 1, i - 1) b
                s = substr(s, i + length(a))
            }
            return out s
        }
        {
            s = rep($0, "<项目名>", ENVIRON["NAME"])
            s = rep(s, "Updated: YYYY-MM-DD HH:MM", "Updated: " ENVIRON["NOW"])
            s = rep(s, "更新：YYYY-MM-DD", "更新：" ENVIRON["TODAY"])
            print s
        }' "$tpl/$1"
}

# Write through a temp file so a failure never leaves an empty file behind.
put() {  # put <template file> <dest>
    if [ -e "$2" ] || [ -L "$2" ]; then
        if [ -f "$2" ] && [ ! -s "$2" ]; then
            echo "WARNING $2 exists but is empty; not overwritten, delete it and rerun" >&2
            status=1
        else
            echo "kept    $2 (already exists)"
        fi
    elif fill "$1" > "$2.tmp.$$" && [ -s "$2.tmp.$$" ] && mv "$2.tmp.$$" "$2"; then
        echo "created $2"
    else
        rm -f "$2.tmp.$$"
        echo "ERROR   could not create $2" >&2
        status=1
    fi
}

# Every file in the profile's template; one named gitignore becomes .gitignore.
while IFS= read -r rel; do
    case $rel in
        gitignore|*/gitignore) dest="${rel%gitignore}.gitignore" ;;
        *) dest=$rel ;;
    esac
    mkdir -p "$(dirname "$dest")"
    put "$rel" "$dest"
done < <(cd "$tpl" && find . -type f ! -name .DS_Store | sed 's#^\./##' | LC_ALL=C sort)

# Shared by every profile (D-40).
[ -e private-notes.md ] || { : > private-notes.md; echo "created private-notes.md"; }
[ -e README.md ] || { printf '# %s\n' "$name" > README.md; echo "created README.md"; }
if [ ! -e CLAUDE.md ] && [ ! -L CLAUDE.md ]; then
    ln -s AGENTS.md CLAUDE.md && echo "linked  CLAUDE.md -> AGENTS.md"
fi

# An AGENTS.md that existed before keeps its content, so it may lack the
# declaration; adding it is an edit to the user's file, left to /adopt.
declared=$(sed -nE '1,5s/^<!-- profile: ([A-Za-z0-9_-]+) -->.*/\1/p' AGENTS.md 2>/dev/null | head -n 1)
if [ -z "$declared" ]; then
    echo "WARNING AGENTS.md has no profile declaration; add '<!-- profile: $profile -->'" \
         "as its first line, then run bin/setup" >&2
    exit 1
elif [ "$declared" != "$profile" ]; then
    echo "WARNING AGENTS.md declares profile '$declared', not '$profile'; a project has" \
         "one profile (D-40), setup not run" >&2
    exit 1
fi
"$root/bin/setup" . || status=1
exit $status

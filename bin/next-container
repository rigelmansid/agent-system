#!/bin/bash
# Print the next free container prefix (P0NN) under the folder that holds all
# projects. Counts active P0NN_ folders at the top level and numbered folders
# one level down, including archives that keep their old Proj.0NN_ names
# (D-10), so a number is never reused (D-44).
#   next-container [root]     root defaults to the current directory
# Compatible with macOS bash 3.2.

set -u
root=${1:-.}
cd "$root" 2>/dev/null || { echo "next-container: no such directory: $root" >&2; exit 2; }

max=$(ls -d P[0-9][0-9][0-9]_* Proj.[0-9][0-9][0-9]_* \
             */P[0-9][0-9][0-9]_* */Proj.[0-9][0-9][0-9]_* 2>/dev/null \
      | sed -nE 's#^(.*/)?(P|Proj\.)([0-9]{3})_.*#\3#p' | sort -n | tail -n 1)
printf 'P%03d\n' $((10#${max:-0} + 1))
